# ────────────────────────────────────────────────────────────────
# TEST ENVIRONMENT — used exclusively by Jest via `npm test`.
#
# WARNING: The globalSetup runs `prisma db push --force-reset`
# against this DATABASE_URL. NEVER point this at your dev or
# production database!
# ────────────────────────────────────────────────────────────────

NODE_ENV=testing

# Test Database (create a separate DB for tests)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/test_db"

# JWT
JWT_ACCESS_SECRET=test-access-secret-key-change-me
JWT_REFRESH_SECRET=test-refresh-secret-key-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary (dummy values – tests should not upload real files)
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=111111111111
CLOUDINARY_API_SECRET=test-secret

# SMTP (disable actual sending in tests)
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ERP Test <no-reply@test.erp>"

# Redis (optional in tests - BullMQ will fail silently)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
